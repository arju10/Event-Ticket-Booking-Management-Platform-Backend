# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
# DATABASE_URL: the POOLED connection (used by the running app at runtime).
#   - Local Postgres: postgresql://user:password@localhost:5432/event_platform
#   - Supabase (Supavisor pooler, port 6543): must include ?pgbouncer=true
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: the DIRECT connection (used only by the Prisma CLI for migrations, via prisma.config.ts).
#   - Local Postgres: same as DATABASE_URL is fine
#   - Supabase: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/event_platform"
DIRECT_URL="postgresql://user:password@localhost:5432/event_platform"

# JWT
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
CLIENT_URL=http://localhost:3000

# Booking
BOOKING_HOLD_MINUTES=15
WAITLIST_OFFER_HOURS=2
